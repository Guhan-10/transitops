# TransitOps backend environment — copy to backend/.env and fill in.
# Never commit the real .env. In hosting/CI, store these as secrets.

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=transitops

# Managed MySQL (hosted) usually needs TLS. DB_SSL_CA is the provider's CA
# certificate as PEM text — only needed if the provider uses its own CA.
DB_SSL=false
DB_SSL_CA=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

PORT=3001

# Comma-separated list of allowed browser origins. Leave empty for local dev.
# Production example: CORS_ORIGIN=https://<your-github-user>.github.io
CORS_ORIGIN=
